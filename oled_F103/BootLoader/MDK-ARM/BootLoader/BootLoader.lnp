--cpu Cortex-M3
"bootloader\startup_stm32f103xb.o"
"bootloader\main.o"
"bootloader\gpio.o"
"bootloader\stm32f1xx_it.o"
"bootloader\stm32f1xx_hal_msp.o"
"bootloader\stm32f1xx_hal_gpio_ex.o"
"bootloader\stm32f1xx_hal.o"
"bootloader\stm32f1xx_hal_rcc.o"
"bootloader\stm32f1xx_hal_rcc_ex.o"
"bootloader\stm32f1xx_hal_gpio.o"
"bootloader\stm32f1xx_hal_dma.o"
"bootloader\stm32f1xx_hal_cortex.o"
"bootloader\stm32f1xx_hal_pwr.o"
"bootloader\stm32f1xx_hal_flash.o"
"bootloader\stm32f1xx_hal_flash_ex.o"
"bootloader\stm32f1xx_hal_exti.o"
"bootloader\system_stm32f1xx.o"
"bootloader\boot_jump.o"
"bootloader\boot_flash.o"
"bootloader\boot_ota.o"
"bootloader\spi_flash.o"
"bootloader\ota_storage.o"
"bootloader\ota_verify.o"
"bootloader\crc32.o"
--strict --scatter "BootLoader\BootLoader.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "BootLoader.map" -o BootLoader\BootLoader.axf